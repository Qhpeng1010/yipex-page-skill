{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yipex.local/schemas/data-binding-v1.json",
  "title": "YiPex Declarative Data Binding",
  "type": "object",
  "required": ["id", "from", "to", "path"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$" },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^[a-zA-Z0-9_.\\[\\]-]+$" },
    "transform": { "enum": ["identity", "pick", "omit", "coerce-string", "coerce-number"] }
  }
}
