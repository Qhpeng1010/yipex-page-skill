{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yipex.local/schemas/page-composition-v1.json",
  "title": "YiPex Page Composition",
  "type": "object",
  "required": ["schemaVersion", "metadata", "ui", "skeleton", "entryHtml", "regions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["changeId", "pageName", "ruleRefs"],
      "additionalProperties": false,
      "properties": {
        "changeId": { "type": "string", "pattern": "^[0-9]{8}-[a-z0-9-]+$" },
        "pageName": { "type": "string", "minLength": 1 },
        "request": { "type": "string" },
        "ruleRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ui": {
      "type": "object",
      "required": ["system", "runtime", "rendererVersion"],
      "additionalProperties": false,
      "properties": {
        "system": { "const": "yipex" },
        "runtime": { "const": "yipex-composition" },
        "rendererVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "entryHtml": { "type": "string", "minLength": 1 },
    "skeleton": { "type": "string", "minLength": 1 },
    "recipeId": { "type": "string", "minLength": 1 },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "capabilities"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$" },
          "type": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "config": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "bindings": { "type": "array", "uniqueItems": true, "items": { "$ref": "data-binding.schema.json" } },
    "transitions": { "type": "array", "items": { "type": "object", "required": ["id", "event", "to"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "event": { "type": "string" }, "to": { "type": "string" }, "requires": { "type": "array", "items": { "type": "string" } }, "bindingIds": { "type": "array", "items": { "type": "string" } } } } },
    "states": { "type": "object", "additionalProperties": true }
  }
}
