{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yipex.local/schemas/form-field-v1.json",
  "title": "YiPex Declarative Form Field",
  "type": "object",
  "required": ["key", "label"],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "type": { "type": "string" },
    "component": {
      "enum": [
        "Input", "Input.TextArea", "Input.Password", "Input.Search", "InputNumber", "Select", "Cascader",
        "Checkbox", "Checkbox.Group", "Switch", "TreeSelect", "Upload", "DatePicker", "DatePicker.RangePicker",
        "TimePicker", "TimePicker.RangePicker", "Radio.Group", "AutoComplete", "Mentions", "Rate", "Slider",
        "Transfer", "ColorPicker", "Segmented"
      ]
    },
    "props": { "type": "object" },
    "options": { "type": "array", "items": { "type": "object" } },
    "optionsSource": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "fallback": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "selectionMode": { "enum": ["multiple", "tags"] },
    "visibleWhen": { "$ref": "#/$defs/condition" },
    "disabledWhen": { "$ref": "#/$defs/condition" },
    "requiredWhen": { "$ref": "#/$defs/condition" },
    "clearWhenHidden": { "type": "boolean" },
    "preserveWhenHidden": { "type": "boolean" },
    "disablePast": { "type": "boolean" },
    "disablePastMessage": { "type": "string" },
    "minSelected": { "type": "integer", "minimum": 0 },
    "maxSelected": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true,
  "$defs": {
    "condition": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["field"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "operator": { "enum": ["eq", "neq", "in", "notIn", "contains", "notContains", "empty", "notEmpty", "gt", "gte", "lt", "lte"] },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } },
          "additionalProperties": false
        }
      ]
    }
  }
}
