{
  "schemaVersion": 2,
  "metadata": {
    "changeId": "20260828-settlement-rule-create",
    "pageName": "新增结算规则",
    "pageType": "settlement-rule-form",
    "componentLibrary": {
      "name": "antd",
      "source": "official"
    },
    "request": "创建一个新增结算规则页面，供财务运营人员配置商户结算规则。表单包含规则名称、适用商户、结算周期、手续费率、最低结算金额、生效时间、自动结算开关和备注。区分必填与选填字段，提供实时校验、未保存离开确认、提交 loading、提交失败和提交成功反馈。主操作为保存规则，次操作为取消；适配桌面和手机，使用演示数据，不虚构后端接口。",
    "assumptions": [
      "未提供真实后端接口，保存操作仅在浏览器中按 page.data.demoSubmission 配置模拟，不发送网络请求。",
      "适用商户和结算周期选项均为明确标注的演示数据。",
      "规则名称、适用商户、结算周期、手续费率、最低结算金额和生效时间为必填；自动结算与备注为选填。",
      "取消或从侧边导航离开时，若表单已修改则先确认；确认后仅更新演示页地址锚点。"
    ],
    "ruleRefs": [
      "DESIGN.md",
      "01-foundations.md",
      "02-components.md",
      "execution/page-contract-v2.md"
    ]
  },
  "contract": {
    "pageFamily": "form",
    "shell": "yipex-default",
    "density": "standard",
    "regions": [
      {
        "id": "form-header",
        "role": "page-header",
        "purpose": "说明新增结算规则任务并标识演示数据"
      },
      {
        "id": "settlement-rule-form",
        "role": "main-form",
        "purpose": "录入并实时校验商户结算规则"
      },
      {
        "id": "form-actions",
        "role": "form-actions",
        "purpose": "提供保存规则和取消操作"
      }
    ],
    "hierarchy": {
      "primary": "完成结算规则配置并保存",
      "secondary": [
        "识别必填与选填字段",
        "理解自动结算的当前状态"
      ]
    },
    "operations": {
      "primary": {
        "id": "save-rule",
        "label": "保存规则",
        "placement": "表单底部操作区右侧",
        "outcome": "校验表单并模拟保存，展示 loading、失败或成功反馈"
      },
      "secondary": [
        {
          "id": "cancel-rule",
          "label": "取消",
          "placement": "表单底部操作区主按钮左侧",
          "outcome": "未修改时离开，已修改时确认后放弃内容"
        }
      ]
    },
    "stateCoverage": [
      "loading",
      "submitting",
      "error",
      "success",
      "unsaved",
      "permission-denied"
    ],
    "responsive": {
      "desktop": "内容宽度受控，基础信息使用两列网格；名称、商户、自动结算和备注横跨整行，操作区右对齐。",
      "narrow": "所有字段改为单列，选择器与日期控件占满宽度，操作按钮保持可触控尺寸并横向排列。"
    },
    "deviations": []
  },
  "page": {
    "shell": {
      "id": "yipex-default",
      "sidebar": {
        "width": 200,
        "background": "#F0F0F0",
        "showCollapseControl": true
      },
      "brand": {
        "name": "Yipex",
        "logo": "logo.svg"
      },
      "navigation": [
        {
          "id": "home",
          "label": "首页",
          "icon": "HomeOutlined"
        },
        {
          "id": "settlement-rules",
          "label": "结算规则",
          "icon": "FileTextOutlined",
          "active": true
        }
      ],
      "header": {
        "welcome": "结算管理",
        "userName": "财务运营",
        "email": "finance@yipex.tech",
        "avatar": "财"
      },
      "footer": {
        "copyright": "Copyright Somei E-Commerce Limited 2025. All rights reserved"
      },
      "floatingTools": {
        "show": false
      }
    },
    "root": {
      "id": "settlement-rule-page",
      "type": "settlement-rule-form-page",
      "props": {
        "title": "新增结算规则"
      },
      "children": [
        {
          "id": "form-header",
          "type": "page-header",
          "label": "新增结算规则"
        },
        {
          "id": "settlement-rule-form",
          "type": "form",
          "label": "规则信息",
          "props": {
            "layout": "vertical",
            "validateTrigger": [
              "onChange",
              "onBlur"
            ]
          },
          "children": [
            {
              "id": "rule-name",
              "type": "input",
              "label": "规则名称",
              "props": {
                "required": true,
                "maxLength": 40,
                "placeholder": "请输入规则名称"
              }
            },
            {
              "id": "merchant-ids",
              "type": "select-multiple",
              "label": "适用商户",
              "props": {
                "required": true,
                "maxSelection": 20,
                "placeholder": "请选择适用商户"
              }
            },
            {
              "id": "settlement-cycle",
              "type": "select",
              "label": "结算周期",
              "props": {
                "required": true,
                "placeholder": "请选择结算周期"
              }
            },
            {
              "id": "fee-rate",
              "type": "input-number",
              "label": "手续费率",
              "props": {
                "required": true,
                "min": 0,
                "max": 100,
                "precision": 4,
                "suffix": "%"
              }
            },
            {
              "id": "minimum-amount",
              "type": "input-number",
              "label": "最低结算金额",
              "props": {
                "required": true,
                "min": 0,
                "max": 1000000,
                "precision": 2,
                "prefix": "¥"
              }
            },
            {
              "id": "effective-at",
              "type": "date-time-picker",
              "label": "生效时间",
              "props": {
                "required": true,
                "futureOnly": true,
                "format": "YYYY-MM-DD HH:mm"
              }
            },
            {
              "id": "auto-settlement",
              "type": "switch",
              "label": "自动结算（选填）",
              "props": {
                "defaultChecked": true
              }
            },
            {
              "id": "notes",
              "type": "textarea",
              "label": "备注（选填）",
              "props": {
                "maxLength": 200,
                "rows": 4,
                "placeholder": "补充适用范围或审批说明"
              }
            }
          ]
        },
        {
          "id": "form-actions",
          "type": "form-actions",
          "children": [
            {
              "id": "cancel-rule",
              "type": "button",
              "label": "取消",
              "events": {
                "click": "cancelRule"
              }
            },
            {
              "id": "save-rule",
              "type": "button",
              "label": "保存规则",
              "props": {
                "buttonType": "primary",
                "htmlType": "submit"
              },
              "events": {
                "click": "saveRule"
              }
            }
          ]
        }
      ]
    },
    "data": {
      "demo": true,
      "merchants": [
        {
          "value": "M10086",
          "label": "海岸咖啡（静安店）"
        },
        {
          "value": "M10092",
          "label": "松果生活馆"
        },
        {
          "value": "M10103",
          "label": "北屿餐厅"
        },
        {
          "value": "M10116",
          "label": "原野户外用品"
        },
        {
          "value": "M10128",
          "label": "白塔书店"
        },
        {
          "value": "M10135",
          "label": "沐光烘焙"
        }
      ],
      "settlementCycles": [
        {
          "value": "T1",
          "label": "T+1（次日结算）"
        },
        {
          "value": "T7",
          "label": "T+7（七日结算）"
        },
        {
          "value": "WEEKLY",
          "label": "每周结算"
        },
        {
          "value": "MONTHLY",
          "label": "每月结算"
        }
      ],
      "initialValues": {
        "autoSettlement": true
      },
      "demoSubmission": {
        "mode": "success",
        "latencyMs": 900,
        "errorMessage": "保存失败，请检查规则内容后重试"
      }
    },
    "states": {
      "loading": false,
      "submitting": false,
      "error": false,
      "success": false,
      "unsaved": false,
      "permission-denied": false
    },
    "interactions": [
      {
        "id": "saveRule",
        "trigger": "save-rule.click",
        "result": "实时校验全部必填字段，模拟提交 loading，并按演示模式展示失败或成功反馈"
      },
      {
        "id": "cancelRule",
        "trigger": "cancel-rule.click",
        "result": "检测未保存修改；存在修改时确认后再放弃内容"
      },
      {
        "id": "validateRuleName",
        "trigger": "rule-name.change",
        "result": "实时校验规则名称长度和首尾空格"
      },
      {
        "id": "confirmUnsavedLeave",
        "trigger": "window.beforeunload or navigation.click",
        "result": "存在未保存修改时阻止直接离开并请求确认"
      }
    ],
    "extensions": {
      "renderer": "settlement-rule-form-v1-antd-shell",
      "componentMap": {
        "form": "Form",
        "ruleName": "Input",
        "merchantIds": "Select mode=multiple",
        "settlementCycle": "Select",
        "feeRate": "InputNumber",
        "minimumAmount": "InputNumber",
        "effectiveAt": "DatePicker showTime",
        "autoSettlement": "Switch",
        "notes": "Input.TextArea",
        "feedback": "Alert + message + Result",
        "leaveConfirm": "Modal.confirm",
        "actions": "Button"
      },
      "responsive": [
        "desktop",
        "mobile"
      ]
    }
  }
}
