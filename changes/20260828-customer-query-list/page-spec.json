{
  "schemaVersion": 2,
  "metadata": {
    "changeId": "20260828-customer-query-list",
    "pageName": "客户查询",
    "pageType": "customer-query-list",
    "componentLibrary": { "name": "antd", "source": "official" },
    "request": "生成一个客户查询列表，支持客户名称、等级和注册日期筛选，支持导出和查看详情。",
    "assumptions": [
      "未提供后端接口，查询、分页、详情和导出均在浏览器内作用于演示数据。",
      "客户等级采用普通、银牌、金牌和 VIP 四级枚举。",
      "客户状态采用正常、待认证和已停用三种演示状态。",
      "注册日期筛选采用闭区间，包含开始日和结束日。",
      "导出在浏览器内生成当前筛选结果的 CSV 文件。",
      "查看详情使用右侧抽屉，以保留当前筛选和分页上下文。"
    ],
    "ruleRefs": [
      "DESIGN.md",
      "01-foundations.md",
      "02-components.md",
      "03-query-list-patterns.md",
      "execution/presentation-intent.md",
      "execution/page-contract-v2.md",
      "execution/capability-model/capability-model.md"
    ],
    "generation": {
      "mode": "auto",
      "strategy": "standard",
      "recipeId": "list.query-table",
      "skeleton": "query-workbench",
      "capabilities": ["query.basic", "query.dateRange", "table.flat", "table.pagination", "table.export", "detail.overlay"],
      "policyVersion": 1,
      "modelVersion": "2026.08.30.2",
      "rendererId": "yipex-standard-query-table-v1"
    }
  },
  "contract": {
    "pageFamily": "list",
    "shell": "yipex-default",
    "density": "compact",
    "regions": [
      { "id": "customer-list-header", "role": "page-header", "purpose": "标识客户查询任务和演示数据" },
      { "id": "customer-filters", "role": "query-controls", "purpose": "按客户名称、编号、等级、状态和注册日期筛选客户" },
      { "id": "customer-results", "role": "result-list", "purpose": "浏览、导出客户并进入详情" },
      { "id": "customer-detail-overlay", "role": "detail-overlay", "purpose": "在不离开列表的情况下查看客户完整信息" }
    ],
    "hierarchy": {
      "primary": "快速找到目标客户并核对客户信息",
      "secondary": ["导出当前筛选结果", "在右侧抽屉查看客户详情"]
    },
    "operations": {
      "primary": { "id": "query-customers", "label": "查询", "placement": "筛选条件区末列右侧", "outcome": "按当前条件筛选演示数据并回到第一页" },
      "secondary": [
        { "id": "reset-customer-filters", "label": "重置", "placement": "查询按钮左侧", "outcome": "清空筛选条件并恢复全部客户" },
        { "id": "export-customers", "label": "导出", "placement": "结果标题右侧", "outcome": "导出当前筛选结果为 CSV 文件" },
        { "id": "view-customer-detail", "label": "详情", "placement": "每行操作列", "outcome": "在右侧抽屉查看当前客户详情" }
      ]
    },
    "stateCoverage": ["loading", "empty", "error", "permission-denied"],
    "responsive": {
      "desktop": "五项筛选使用四列网格；前四项位于首行，第五项与右对齐操作组位于第二行；结果表格完整展示，11 项客户详情使用两列 Modal。",
      "narrow": "筛选条件改为单列，查询操作位于最后一行；结果表格保留横向滚动，抽屉宽度适配手机视口。"
    },
    "deviations": []
  },
