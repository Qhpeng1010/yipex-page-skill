        "role": "detail-overlay",
        "purpose": "在不离开列表的情况下查看商户完整信息"
      }
    ],
    "hierarchy": {
      "primary": "快速找到目标商户并查看经营与归属信息",
      "secondary": [
        "批量选择和导出当前工作结果",
        "在右侧抽屉核对商户详情"
      ]
    },
    "operations": {
      "primary": {
        "id": "query-merchants",
        "label": "查询",
        "placement": "筛选条件区底部右侧",
