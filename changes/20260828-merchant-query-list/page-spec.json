      },
      "secondary": [
        {
          "id": "reset-filters",
          "label": "重置",
          "placement": "查询按钮左侧",
          "outcome": "清空筛选条件并恢复全部商户"
        },
        {
          "id": "export-merchants",
          "label": "导出",
          "placement": "结果标题右侧",
          "outcome": "导出已选商户；未选择时导出当前筛选结果"
        }
      ]
    },
