    "shell": "yipex-default",
    "density": "compact",
    "regions": [
      { "id": "order-header", "role": "page-header", "purpose": "标识订单查询任务" },
      { "id": "order-query", "role": "query-controls", "purpose": "按订单号、客户名称、订单状态和日期范围筛选订单" },
      { "id": "order-results", "role": "result-list", "purpose": "展示订单结果并分页浏览" },
      { "id": "order-detail", "role": "detail-overlay", "purpose": "在列表上下文中查看订单完整信息" }
    ],
    "hierarchy": {
      "primary": "快速定位并核对目标订单",
      "secondary": ["在详情抽屉查看订单核心信息"]
    },
    "operations": {
      "primary": { "id": "query-orders", "label": "查询", "placement": "查询条件区末列", "outcome": "应用当前筛选条件并回到第一页" },
      "secondary": [
        { "id": "reset-order-query", "label": "重置", "placement": "查询按钮左侧", "outcome": "清空筛选条件并恢复全部订单" },
        { "id": "view-order-detail", "label": "查看详情", "placement": "每行操作列", "outcome": "打开订单详情抽屉" }
      ]
    },
    "stateCoverage": ["loading", "empty", "error", "permission-denied"],
    "responsive": {
      "desktop": "四项筛选使用四列网格；金额列右对齐，操作列固定在表格右侧，详情使用右侧抽屉。",
      "narrow": "筛选条件改为单列；表格在结果区域内横向滚动，详情抽屉接近全宽并改为单列。"
    },
    "deviations": []
  },
