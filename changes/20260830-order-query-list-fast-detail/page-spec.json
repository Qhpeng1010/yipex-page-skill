    "pageName": "订单查询",
    "pageType": "order-query-list",
    "componentLibrary": { "name": "antd", "source": "official" },
    "request": "生成订单查询列表页面。查询条件包括订单号、客户名称、订单状态和日期范围，支持查询、重置、分页和查看详情。表格展示订单号、客户、客户、订单金额(元)、订单状态、支付渠道和下单时间，金额右对齐，不显示演示数据标签",
    "assumptions": [
      "表格字段中的“客户、客户”按明显重复输入去重为一个“客户”列。",
      "需求未指定详情字段，详情沿用列表核心字段并补充客户编号，共 7 项，使用 Drawer 保留列表上下文。",
      "未提供后端接口，查询、分页和详情基于浏览器内置数据；按要求不在可见页面中显示演示数据标签。"
    ],
    "ruleRefs": [
      "execution/context-packs/core.md",
      "design-system/director-rules/01-visual-constitution.md",
      "design-system/director-rules/02-template-application-rules.md",
      "design-system/director-rules/03-interaction-acceptance-rules.md",
      "design-system/page-patterns/list.md",
      "execution/page-contract-v2.md",
      "execution/capability-model/capability-model.md"
    ],
    "generation": {
      "mode": "auto",
      "strategy": "standard",
      "recipeId": "list.query-table",
      "skeleton": "query-workbench",
      "capabilities": ["query.basic", "table.flat", "table.pagination", "query.dateRange", "detail.overlay"],
      "policyVersion": 2,
      "modelVersion": "2026.08.30.7",
      "rendererId": "yipex-standard-query-table-v1"
    }
  },
  "contract": {
