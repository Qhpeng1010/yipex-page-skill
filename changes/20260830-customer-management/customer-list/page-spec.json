{
  "schemaVersion": 2,
  "metadata": {
    "changeId": "20260830-customer-management-list",
    "pageName": "客户管理",
    "pageType": "customer-query-list",
    "componentLibrary": {
      "name": "antd",
      "source": "official"
    },
    "request": "/yipex:page 生成客户管理流程，包含客户列表和新增客户两个关联页面。客户列表支持关键词、客户类型和状态筛选，表格顶部提供“新增客户”按钮；点击后进入新增客户页面。新增页面包含基础信息、联系人和结算信息，提交成功后返回客户列表，并用 message 提示成功，按创建时间倒序展示新客户；取消时直接返回且不保存",
    "assumptions": [
      "未提供后端接口，列表与新增操作使用浏览器本地演示数据。",
      "客户列表以客户编号、名称、类型、联系人、结算方式、状态和创建时间帮助运营人员完成日常管理。",
      "新增客户提交后通过本地演示存储在列表中插入记录，并按创建时间倒序置顶；返回列表时由列表页显示成功 message。"
    ],
    "ruleRefs": [
      "DESIGN.md",
      "01-foundations.md",
      "02-components.md",
      "03-query-list-patterns.md",
      "execution/presentation-intent.md",
      "execution/page-contract-v2.md",
      "execution/capability-model/capability-model.md"
    ],
    "generation": {
      "mode": "auto",
      "strategy": "standard",
      "recipeId": "list.query-table",
      "skeleton": "query-workbench",
      "capabilities": [
        "query.basic",
        "table.flat",
        "table.pagination"
      ],
      "policyVersion": 1,
      "modelVersion": "2026.08.30.1",
      "rendererId": "yipex-standard-query-table-v1"
    }
  },
  "contract": {
    "pageFamily": "list",
    "shell": "yipex-default",
    "density": "compact",
    "regions": [
      {
        "id": "customer-list-header",
        "role": "page-header",
        "purpose": "标识客户管理任务"
      },
      {
        "id": "customer-filters",
        "role": "query-controls",
        "purpose": "按关键词、客户类型和状态筛选客户"
      },
      {
        "id": "customer-results",
        "role": "result-list",
        "purpose": "浏览客户并进入新增流程"
      }
    ],
    "hierarchy": {
      "primary": "快速定位并管理客户",
      "secondary": [
        "从列表进入新增客户页面",
        "识别刚创建的客户"
      ]
    },
    "operations": {
      "primary": {
        "id": "query-customers",
        "label": "查询",
        "placement": "筛选条件区末列右侧",
        "outcome": "按当前条件筛选客户并回到第一页"
      },
      "secondary": [
        {
          "id": "reset-customer-filters",
          "label": "重置",
          "placement": "查询按钮左侧",
          "outcome": "清空筛选条件并恢复全部客户"
        },
        {
          "id": "create-customer",
          "label": "新增客户",
          "placement": "列表标题工具区最右侧",
          "outcome": "进入新增客户页面"
        }
      ]
    },
    "stateCoverage": [
      "loading",
      "empty",
      "error",
      "permission-denied",
      "success"
    ],
    "responsive": {
      "desktop": "三项筛选使用四列网格，操作组与第三项同处末行右侧；客户表格按创建时间倒序展示。",
      "narrow": "筛选条件改为单列，列表保留横向滚动，返回列表后的成功反馈使用 message，不改变行样式。"
    },
