            {
              "id": "save-customer",
              "type": "button",
              "label": "提交",
              "events": {
                "click": "saveCustomer"
              }
            }
          ]
        }
      ]
    },
    "data": {
      "demo": true,
      "persistenceKey": "yipex-customer-management-demo",
      "sections": [
        {
          "id": "basic",
          "title": "基础信息",
          "fields": [
            {
              "key": "customerId",
              "label": "客户编号",
              "required": true,
              "placeholder": "请输入客户编号，例如 C20260830021"
            },
            {
              "key": "customerName",
              "label": "客户名称",
              "required": true,
              "placeholder": "请输入企业或个人名称"
            },
            {
              "key": "customerType",
              "label": "客户类型",
              "type": "select",
              "required": true,
              "options": [
                {
                  "value": "MERCHANT",
                  "label": "企业客户"
                },
                {
                  "value": "INDIVIDUAL",
                  "label": "个人客户"
                }
              ]
            }
          ]
        },
        {
          "id": "contact",
          "title": "联系人",
          "fields": [
            {
              "key": "contactName",
              "label": "联系人姓名",
              "required": true,
              "placeholder": "请输入联系人姓名"
            },
            {
              "key": "contactPhone",
              "label": "联系电话",
              "type": "text",
              "required": true,
              "placeholder": "请输入手机号"
            },
            {
              "key": "contactEmail",
              "label": "联系邮箱",
              "type": "text",
              "required": true,
              "placeholder": "请输入邮箱地址"
            }
          ]
        },
        {
          "id": "settlement",
          "title": "结算信息",
          "fields": [
            {
              "key": "settlementCycle",
              "label": "结算周期",
              "type": "select",
              "required": true,
              "options": [
                {
                  "value": "T1",
                  "label": "T+1"
                },
                {
                  "value": "T7",
                  "label": "T+7"
                },
                {
                  "value": "MONTHLY",
                  "label": "月结"
                }
              ]
            },
            {
              "key": "settlementCycleLabel",
              "label": "结算方式名称",
              "required": true,
              "placeholder": "例如：月结"
            },
            {
              "key": "settlementCurrency",
              "label": "结算币种",
              "type": "select",
              "required": true,
              "options": [
                {
                  "value": "CNY",
                  "label": "CNY"
                },
                {
                  "value": "USD",
                  "label": "USD"
                },
                {
                  "value": "USDT",
                  "label": "USDT"
                }
              ]
            },
            {
              "key": "settlementAccount",
              "label": "结算账户",
              "required": true,
              "span": "full",
              "placeholder": "请输入银行卡号或钱包地址"
            }
          ]
        }
      ],
      "initialValues": {
        "customerType": "MERCHANT",
        "settlementCurrency": "CNY"
      },
      "demoSubmission": {
        "mode": "success",
        "latencyMs": 500,
        "successMessage": "客户新增成功",
        "returnHref": "../customer-list/preview.html"
      },
      "resetOnRefresh": true,
      "entryHref": "../customer-list/preview.html"
    },
    "states": {
      "loading": false,
      "submitting": false,
      "error": false,
      "success": false,
      "permission-denied": false
