        "form.stickyActions",
        "action.primary",
        "action.secondary"
      ],
      "policyVersion": 1,
      "modelVersion": "2026.08.30.1",
      "rendererId": "yipex-standard-grouped-form-v1"
    }
  },
  "contract": {
