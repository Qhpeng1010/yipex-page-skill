        "role": "action",
        "purpose": "提交客户或取消返回列表"
      }
    ],
    "hierarchy": {
      "primary": "完成客户资料录入并提交",
      "secondary": [
        "按信息分组核对字段",
        "取消时不保存并返回客户列表"
      ]
    },
    "operations": {
