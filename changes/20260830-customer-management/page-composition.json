{
  "schemaVersion": 1,
  "metadata": {
    "changeId": "20260830-customer-management",
    "pageName": "客户管理流程",
    "request": "/yipex:page 生成客户管理流程，包含客户列表和新增客户两个关联页面。客户列表支持关键词、客户类型和状态筛选，表格顶部提供“新增客户”按钮；点击后进入新增客户页面。新增页面包含基础信息、联系人和结算信息，提交成功后返回客户列表，并在返回列表后用 message 提示成功，按创建时间倒序置顶；取消时直接返回且不保存",
    "ruleRefs": [
      "execution/capability-model/page-composition.schema.json",
      "execution/capability-model/composition-rules.json",
      "execution/capability-model/data-binding.schema.json"
    ]
  },
  "ui": {
    "system": "yipex",
    "runtime": "yipex-composition",
    "rendererVersion": 1
  },
  "skeleton": "custom-composition",
  "regions": [
    {
      "id": "customer-list",
      "type": "content",
      "capabilities": [
        "query.basic",
        "table.flat",
        "table.pagination"
      ],
      "config": {
        "pageSpec": "customer-list/page-spec.json",
        "preview": "customer-list/preview.html"
      }
    },
    {
      "id": "customer-create",
      "type": "content",
      "capabilities": [
        "form.groups",
        "form.validation",
        "form.stickyActions"
      ],
      "config": {
        "pageSpec": "customer-create/page-spec.json",
        "preview": "customer-create/preview.html"
      }
    },
    {
      "id": "customer-actions",
      "type": "action",
      "capabilities": [
        "action.primary",
        "action.secondary"
      ],
      "config": {
        "entry": "customer-list",
        "return": "customer-list"
      }
    }
  ],
  "bindings": [
    {
      "id": "list-row-to-create",
      "from": "customer-list.create-customer",
      "to": "customer-create.form",
      "path": "customerId",
      "transform": "identity"
    },
    {
      "id": "create-to-list-first-item",
      "from": "customer-create.save-customer",
      "to": "customer-list.records",
      "path": "customerId",
      "transform": "coerce-string"
    }
  ],
  "transitions": [
    {
      "id": "list-to-create",
      "from": "customer-list.create-customer",
      "event": "openPage",
      "to": "customer-create",
      "requires": [
        "action.primary"
      ]
    },
    {
      "id": "create-submit-to-list",
      "from": "customer-create.save-customer",
      "event": "submitted",
      "to": "customer-list",
      "bindingIds": [
        "create-to-list-first-item"
      ]
    },
    {
      "id": "create-cancel-to-list",
      "from": "customer-create.cancel-customer",
      "event": "cancelled",
      "to": "customer-list"
    }
  ],
  "states": {
    "customer-list": [
      "loading",
      "empty",
      "error",
      "permission-denied",
      "success"
    ],
    "customer-create": [
      "loading",
      "submitting",
      "error",
      "success",
      "permission-denied"
    ]
  },
  "entryHtml": "preview.html"
}
