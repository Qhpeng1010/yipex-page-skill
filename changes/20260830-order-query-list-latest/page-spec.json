    "hierarchy": {
      "primary": "快速找到并处理目标订单",
      "secondary": ["导出当前筛选结果", "在详情抽屉查看订单信息"]
    },
    "operations": {
      "primary": { "id": "query-orders", "label": "查询", "placement": "查询条件区操作组", "outcome": "应用筛选条件并回到第一页" },
      "secondary": [
