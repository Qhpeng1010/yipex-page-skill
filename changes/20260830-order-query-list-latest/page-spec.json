        { "id": "export-orders", "label": "导出", "placement": "结果标题右侧", "outcome": "导出当前筛选结果 CSV" },
        { "id": "view-order-detail", "label": "详情", "placement": "每行操作列", "outcome": "打开订单详情抽屉" }
