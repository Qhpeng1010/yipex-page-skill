      { "id": "order-filters", "role": "query-controls", "purpose": "按关键词、日期、状态和渠道筛选订单" },
      { "id": "order-results", "role": "result-list", "purpose": "浏览订单、导出结果并进入详情" },
      { "id": "order-detail-overlay", "role": "detail-overlay", "purpose": "在列表上下文中查看订单完整信息" }
