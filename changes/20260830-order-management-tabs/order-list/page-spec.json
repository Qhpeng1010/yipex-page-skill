        "id": "order-create-overlay",
        "role": "form-overlay",
        "purpose": "按录入字段数量在列表上下文中使用 Modal 或 Drawer"
      }
    ],
    "hierarchy": {
      "primary": "快速定位并处理订单",
      "secondary": [
        "按状态切换订单范围",
        "查看详情或取消待付款订单"
