{
  "schemaVersion": 2,
  "metadata": {
    "changeId": "20260828-fund-flow-query-list",
    "pageName": "资金流水查询",
    "pageType": "fund-flow-query-list",
    "componentLibrary": { "name": "antd", "source": "official" },
    "request": "/yipex:page 生成资金流水查询页面。查询条件：日期、订单类型、订单状态、地址条件，支持重置和查询。表格展示：流水编号、类型、对手方名称、金额、币种、流水状态、创建时间。操作查看详情和取消订单。查询列表有新增流水记录的功能，新增用抽屉展示信息，信息帮我补充一下。",
    "assumptions": [
      "未提供后端接口，查询、分页、详情、取消和新增均在浏览器内作用于演示数据。",
      "地址条件按付款地址、收款地址和对手方名称进行模糊匹配。",
      "日期筛选采用闭区间，包含开始日和结束日。",
      "新增流水记录补充方向、对手方、金额、币种、付款地址、收款地址、备注和到账时间，便于完成一笔流水的完整录入。",
      "取消订单仅对待处理流水开放，并在浏览器内更新为已取消状态。"
    ],
    "ruleRefs": ["DESIGN.md", "01-foundations.md", "02-components.md", "03-query-list-patterns.md", "execution/presentation-intent.md", "execution/page-contract-v2.md", "execution/capability-model/capability-model.md"],
    "generation": { "mode": "auto", "strategy": "standard", "recipeId": "list.query-detail-overlay", "skeleton": "query-workbench", "capabilities": ["query.basic", "query.dateRange", "table.flat", "table.pagination", "detail.overlay"], "policyVersion": 1, "modelVersion": "2026.08.30.2", "rendererId": "yipex-standard-query-table-v1" }
  },
  "contract": {
    "pageFamily": "list", "shell": "yipex-default", "density": "compact",
    "regions": [
      { "id": "fund-flow-list-header", "role": "page-header", "purpose": "标识资金流水查询任务" },
      { "id": "fund-flow-filters", "role": "query-controls", "purpose": "按日期、订单类型、订单状态和地址筛选流水" },
      { "id": "fund-flow-results", "role": "result-list", "purpose": "浏览流水记录并执行详情和取消操作" },
      { "id": "fund-flow-detail-overlay", "role": "detail-overlay", "purpose": "在不离开列表的情况下查看流水完整信息" },
      { "id": "fund-flow-create-drawer", "role": "create-overlay", "purpose": "在当前列表上下文中录入新的资金流水" }
    ],
    "hierarchy": { "primary": "快速定位流水并核对资金状态", "secondary": ["新增一笔资金流水", "查看流水详情或取消待处理订单"] },
    "operations": {
      "primary": { "id": "query-fund-flows", "label": "查询", "placement": "筛选条件区末列右侧", "outcome": "按当前条件筛选演示流水并回到第一页" },
      "secondary": [
        { "id": "reset-fund-flow-filters", "label": "重置", "placement": "查询按钮左侧", "outcome": "清空筛选条件并恢复全部流水" },
        { "id": "create-fund-flow", "label": "新增流水记录", "placement": "结果标题右侧", "outcome": "打开右侧抽屉录入并新增一笔流水" },
        { "id": "view-fund-flow-detail", "label": "详情", "placement": "每行操作列", "outcome": "在右侧抽屉查看当前流水详情" },
        { "id": "cancel-fund-flow", "label": "取消订单", "placement": "每行操作列", "outcome": "确认后将待处理流水更新为已取消" }
      ]
    },
    "stateCoverage": ["loading", "empty", "error", "permission-denied"],
    "responsive": { "desktop": "四项筛选使用四列网格，结果表格完整展示；详情和新增均使用右侧 520px 抽屉。", "narrow": "筛选条件改为单列；结果表格保留横向滚动；抽屉宽度适配手机视口，新增表单保持单列。" },
