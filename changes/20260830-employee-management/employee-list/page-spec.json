        { "id": "employee-status", "key": "status", "label": "状态", "type": "select", "placeholder": "请选择状态", "options": [{ "value": "ALL", "label": "全部状态" }, { "value": "ACTIVE", "label": "在职" }, { "value": "PENDING", "label": "待入职" }, { "value": "INACTIVE", "label": "已离职" }] }
