{
  "schemaVersion": 2,
  "metadata": {
    "changeId": "20260830-employee-management-list",
    "pageName": "员工管理",
    "pageType": "employee-query-list",
    "componentLibrary": { "name": "antd", "source": "official" },
    "request": "/yipex:page 生成员工管理流程，包含员工查询列表和员工信息分组表单。查询列表支持按姓名、部门和状态筛选，展示姓名、工号、部门、岗位和状态，提供新增员工和查看详情操作。点击新增员工进入分组表单，表单分为基本信息和工作信息两组，包含姓名、工号、手机号、部门、岗位和状态字段，支持取消和保存。保存成功后返回员工列表并刷新数据",
    "assumptions": [
      "未提供后端接口，员工查询、详情和新增使用浏览器本地演示数据。",
      "保存成功后按创建时间倒序刷新列表，新员工显示在第一条且不增加持久高亮。"
    ],
    "ruleRefs": [
      "execution/context-packs/core.md",
      "design-system/DESIGN.md",
      "design-system/director-rules/01-visual-constitution.md",
      "execution/context-packs/interaction.md",
      "execution/context-packs/accessibility.md",
      "execution/context-packs/layout.md",
      "execution/context-packs/components.md",
      "design-system/03-query-list-patterns.md",
      "execution/page-contract-v2.md"
    ],
    "generation": {
      "mode": "auto",
      "strategy": "standard",
      "recipeId": "list.query-detail-overlay",
      "skeleton": "query-workbench",
      "capabilities": ["query.basic", "table.flat", "table.pagination", "detail.overlay", "form.overlay"],
      "policyVersion": 1,
      "modelVersion": "2026.08.30.4",
      "rendererId": "yipex-standard-query-table-v1"
    }
  },
  "contract": {
    "pageFamily": "list",
    "shell": "yipex-default",
    "density": "compact",
    "regions": [
      { "id": "employee-list-header", "role": "page-header", "purpose": "标识员工管理任务" },
      { "id": "employee-filters", "role": "query-controls", "purpose": "按姓名、部门和状态筛选员工" },
      { "id": "employee-results", "role": "result-list", "purpose": "浏览员工并执行新增或详情操作" },
      { "id": "employee-detail", "role": "detail-overlay", "purpose": "在列表上下文中查看员工完整信息" },
      { "id": "employee-create", "role": "form-overlay", "purpose": "在列表上下文中按基本信息和工作信息分组新增员工" }
    ],
    "hierarchy": {
      "primary": "快速定位并管理员工",
      "secondary": ["从列表新增员工", "查看员工完整信息"]
    },
    "operations": {
      "primary": { "id": "query-employees", "label": "查询", "placement": "查询条件区末列", "outcome": "按当前条件筛选员工并回到第一页" },
      "secondary": [
        { "id": "reset-employee-filters", "label": "重置", "placement": "查询按钮左侧", "outcome": "清空筛选条件并恢复全部员工" },
        { "id": "create-employee", "label": "新增员工", "placement": "列表标题工具区最右侧", "outcome": "打开新增员工弹窗" },
        { "id": "view-employee-detail", "label": "查看详情", "placement": "每行操作列", "outcome": "打开详情抽屉并保留列表上下文" }
      ]
    },
    "stateCoverage": ["loading", "empty", "error", "permission-denied", "success"],
    "responsive": {
      "desktop": "三项筛选使用四列网格，结果表格展示核心员工字段；六项新增信息使用两列 Modal，详情使用两列 Drawer。",
      "narrow": "筛选条件和新增字段改为单列，表格保留横向滚动；详情抽屉接近全宽并降为单列。"
    },
    "deviations": []
  },
  "page": {
