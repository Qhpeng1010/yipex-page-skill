      "secondary": [
        { "id": "cancel-employee", "label": "取消", "placement": "保存按钮左侧", "outcome": "不保存当前内容并返回员工列表" }
      ]
    },
    "stateCoverage": ["loading", "submitting", "error", "success", "permission-denied"],
