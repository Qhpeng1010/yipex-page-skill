          "title": "基本信息",
          "fields": [
            { "key": "name", "label": "姓名", "type": "text", "required": true, "maxLength": 40, "placeholder": "请输入员工姓名" },
            { "key": "id", "label": "工号", "type": "text", "required": true, "maxLength": 30, "placeholder": "请输入工号，例如 EMP202608021" },
            { "key": "phone", "label": "手机号", "type": "text", "required": true, "maxLength": 20, "placeholder": "请输入手机号" }
          ]
        },
        {
          "id": "work",
          "title": "工作信息",
          "fields": [
            { "key": "department", "label": "部门", "type": "select", "required": true, "labelKey": "departmentLabel", "placeholder": "请选择部门", "options": [{ "value": "PRODUCT", "label": "产品部" }, { "value": "TECHNOLOGY", "label": "技术部" }, { "value": "OPERATIONS", "label": "运营部" }, { "value": "FINANCE", "label": "财务部" }, { "value": "HR", "label": "人力资源部" }] },
            { "key": "position", "label": "岗位", "type": "select", "required": true, "labelKey": "positionLabel", "placeholder": "请选择岗位", "options": [{ "value": "PRODUCT_MANAGER", "label": "产品经理" }, { "value": "FRONTEND_ENGINEER", "label": "前端工程师" }, { "value": "BACKEND_ENGINEER", "label": "后端工程师" }, { "value": "OPERATIONS_SPECIALIST", "label": "运营专员" }, { "value": "ACCOUNTANT", "label": "会计" }, { "value": "HR_SPECIALIST", "label": "人事专员" }] },
            { "key": "status", "label": "状态", "type": "select", "required": true, "labelKey": "statusLabel", "placeholder": "请选择状态", "options": [{ "value": "ACTIVE", "label": "在职" }, { "value": "PENDING", "label": "待入职" }, { "value": "INACTIVE", "label": "已离职" }] }
          ]
        }
      ],
      "initialValues": { "status": "ACTIVE" },
      "demoSubmission": { "mode": "success", "latencyMs": 500, "successMessage": "员工新增成功", "returnHref": "../employee-list/preview.html" },
      "resetOnRefresh": true,
      "entryHref": "../employee-list/preview.html"
    },
    "states": { "loading": false, "submitting": false, "error": false, "success": false, "permission-denied": false },
    "interactions": [
      { "id": "saveEmployee", "source": "save-employee", "event": "click", "outcome": "校验并保存员工，返回列表后刷新数据并提示成功" },
      { "id": "cancelEmployee", "source": "cancel-employee", "event": "click", "outcome": "不保存当前内容并直接返回列表" }
    ],
    "extensions": {
      "presentationDecisions": {
        "employee-form": { "mode": "grouped-form-sections", "confidence": "explicit", "evidence": ["用户明确要求基本信息和工作信息两个分组"], "baseComponent": "Card + Form", "requiresDeviation": false }
      },
      "renderer": "yipex-standard-grouped-form-v1",
      "generation": {
        "strategy": "standard",
        "recipeId": "form.grouped-submit",
