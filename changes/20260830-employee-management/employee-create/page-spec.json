      "narrow": "字段改为单列，保持两组结构，操作栏覆盖全宽。"
    },
    "deviations": []
  },
  "page": {
    "shell": {
      "id": "yipex-default",
      "sidebar": { "width": 200, "background": "#F0F0F0", "showCollapseControl": true },
