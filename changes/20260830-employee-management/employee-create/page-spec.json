          "id": "employee-form",
          "type": "form",
          "label": "新增员工表单",
          "children": [
            { "id": "employee-basic-section", "type": "form-section", "label": "基本信息" },
            { "id": "employee-work-section", "type": "form-section", "label": "工作信息" }
          ]
        },
        {
          "id": "employee-form-actions",
          "type": "action",
          "children": [
