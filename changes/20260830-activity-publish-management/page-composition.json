{
  "schemaVersion": 1,
  "metadata": {
    "changeId": "20260830-activity-publish-management",
    "pageName": "活动发布管理流程",
    "request": "生成活动发布管理流程，包含活动列表和新增活动分步表单。",
    "ruleRefs": ["execution/capability-model/page-composition.schema.json", "execution/capability-model/composition-rules.json", "execution/capability-model/data-binding.schema.json", "execution/page-contract-v2.md"]
  },
  "ui": { "system": "yipex", "runtime": "yipex-composition", "rendererVersion": 1 },
  "skeleton": "custom-composition",
  "regions": [
    { "id": "activity-list", "type": "content", "capabilities": ["query.basic", "query.dateRange", "table.flat", "table.pagination", "table.status", "detail.overlay", "action.confirm", "navigation.openPage"], "config": { "pageSpec": "activity-list/page-spec.json", "preview": "activity-list/preview.html" } },
    { "id": "activity-create", "type": "content", "capabilities": ["form.steps", "form.validation", "form.stickyActions", "form.review", "action.primary", "action.secondary", "binding.submissionToResult", "navigation.openPage"], "config": { "pageSpec": "activity-create/page-spec.json", "preview": "activity-create/preview.html" } }
  ],
  "bindings": [{ "id": "create-activity-to-list-records", "from": "activity-create.publish-activity", "to": "activity-list.records", "path": "activityId", "transform": "coerce-string" }],
  "transitions": [
    { "id": "list-to-create", "from": "activity-list.create-activity", "event": "openPage", "to": "activity-create", "requires": ["navigation.openPage"] },
    { "id": "list-to-edit", "from": "activity-list.edit-activity", "event": "openPage", "to": "activity-create", "requires": ["navigation.openPage"] },
    { "id": "create-publish-to-list", "from": "activity-create.publish-activity", "event": "submitted", "to": "activity-list", "bindingIds": ["create-activity-to-list-records"] },
    { "id": "create-cancel-to-list", "from": "activity-create.cancel-activity", "event": "cancelled", "to": "activity-list", "requires": ["navigation.openPage"] }
  ],
  "states": { "activity-list": ["loading", "empty", "error", "permission-denied", "success"], "activity-create": ["loading", "submitting", "error", "success", "permission-denied"] },
  "entryHtml": "preview.html"
}
