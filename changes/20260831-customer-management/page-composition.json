{
  "schemaVersion": 1,
  "metadata": {
    "changeId": "20260831-customer-management",
    "pageName": "客户管理流程",
    "request": "/yipex:fast 生成客户管理流程，包含客户查询列表和新增客户表单两个页面。列表支持按客户名称、客户类型和状态查询，展示客户名称、类型、联系人、状态和创建时间。点击“新增客户”进入表单，表单分为基础信息、联系人和结算信息三组，支持校验、保存和取消。保存成功后返回列表并刷新数据，取消不保存。",
    "ruleRefs": [
      "execution/capability-model/page-composition.schema.json",
      "execution/capability-model/composition-rules.json",
      "execution/capability-model/data-binding.schema.json"
    ]
  },
  "ui": {
    "system": "yipex",
    "runtime": "yipex-composition",
    "rendererVersion": 1
  },
  "skeleton": "custom-composition",
  "regions": [
    {
      "id": "customer-list",
      "type": "content",
      "capabilities": [
        "query.basic",
        "table.flat",
        "table.pagination"
      ],
      "config": {
        "pageSpec": "customer-list/page-spec.json",
        "preview": "customer-list/preview.html"
      }
    },
    {
      "id": "customer-create",
      "type": "content",
      "capabilities": [
        "form.groups",
        "form.validation",
        "form.stickyActions"
      ],
      "config": {
        "pageSpec": "customer-create/page-spec.json",
        "preview": "customer-create/preview.html"
      }
    },
    {
      "id": "customer-actions",
      "type": "action",
      "capabilities": [
        "action.primary",
        "action.secondary"
      ],
      "config": {
        "entry": "customer-list",
        "return": "customer-list"
      }
    }
  ],
  "bindings": [
    {
      "id": "list-row-to-create",
      "from": "customer-list.create-customer",
      "to": "customer-create.form",
      "path": "customerId",
      "transform": "identity"
    },
    {
      "id": "create-to-list-first-item",
      "from": "customer-create.save-customer",
      "to": "customer-list.records",
      "path": "customerId",
      "transform": "coerce-string"
    }
  ],
  "transitions": [
    {
      "id": "list-to-create",
      "from": "customer-list.create-customer",
      "event": "openPage",
      "to": "customer-create",
      "requires": [
        "action.primary"
      ]
    },
    {
      "id": "create-submit-to-list",
      "from": "customer-create.save-customer",
      "event": "submitted",
      "to": "customer-list",
      "bindingIds": [
        "create-to-list-first-item"
      ]
    },
    {
      "id": "create-cancel-to-list",
      "from": "customer-create.cancel-customer",
      "event": "cancelled",
      "to": "customer-list"
    }
  ],
  "states": {
    "customer-list": [
      "loading",
      "empty",
      "error",
      "permission-denied",
      "success"
    ],
    "customer-create": [
      "loading",
      "submitting",
      "error",
      "success",
      "permission-denied"
    ]
  },
  "entryHtml": "preview.html"
}
